   /**
    * @brief Percent-encode URL data for use in HTTP query strings.
    */
   std::string url_escape(const std::string &url) {
+#ifdef __SCE__
+    // Same output as curl_easy_escape: RFC 3986 unreserved characters stay, the rest is %XX.
+    static constexpr char hex[] = "0123456789ABCDEF";
+    std::string result;
+    for (const unsigned char c : url) {
+      if (std::isalnum(c) || c == '-' || c == '.' || c == '_' || c == '~') {
+        result += static_cast<char>(c);
+      } else {
+        result += '%';
+        result += hex[c >> 4];
+        result += hex[c & 15];
+      }
+    }
+    return result;
+#else
     char *string = curl_easy_escape(nullptr, url.c_str(), static_cast<int>(url.length()));
     std::string result(string);
     curl_free(string);
     return result;
+#endif
   }
 
