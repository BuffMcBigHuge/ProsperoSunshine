+  namespace {
+    std::mutex launch_client_mutex;
+    launch_client_t last_launch_client;
+
+    void remember_launch_client(const std::string &name, const std::string &address) {
+      std::scoped_lock lock {launch_client_mutex};
+      last_launch_client = {name, address};
+    }
+  }  // namespace
+
+  launch_client_t get_last_launch_client() {
+    std::scoped_lock lock {launch_client_mutex};
+    return last_launch_client;
+  }
