+  int gamepad_count(const std::shared_ptr<input_t> &input) {
+    // The input task assigns the ids; a count taken meanwhile is a snapshot for display, one arrival early or late.
+    int count = 0;
+    for (const auto &gamepad : input->gamepads) {
+      if (gamepad.id >= 0) {
+        ++count;
+      }
+    }
+    return count;
+  }
