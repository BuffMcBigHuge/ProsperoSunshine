+    int count_except_cert(std::string_view cert) {
+      auto lg = _session_slots.lock();
+      int count = 0;
+      for (const auto &slot : *_session_slots) {
+        if (stream::session::client_cert(*slot) != cert) {
+          ++count;
+        }
+      }
+      return count;
+    }
